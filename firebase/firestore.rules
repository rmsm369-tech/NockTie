rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'rmsm369@gmail.com';
    }

    match /users/{uid} {
      // Users can create their own document when signed up
      allow create: if request.auth != null && request.auth.uid == uid;

      // Users can read their own document fully
      allow get: if request.auth != null && request.auth.uid == uid;

      // Other users may read only public fields (client should enforce), server-side only allow reads
      // from others when requesting public fields - Firestore rules cannot mask fields; to enforce
      // true separation, store private fields in a subcollection or separate doc.
      allow list: if request.auth != null;

      // Users can update limited fields on their own document
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','avatarConfig','personalitySummary','blueTick']) || isAdmin();

      // Only admin can delete user documents
      allow delete: if isAdmin();
    }

    match /users/{uid}/messages/{msg} {
      allow create, read, delete: if request.auth != null && request.auth.uid == uid;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    match /waitlist/{email} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // Admin-only collections
    match /admins/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
